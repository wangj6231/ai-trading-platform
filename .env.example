# This file contains DEVELOPMENT-ONLY placeholders. Never use them in production.
# Production must set APP_ENV=production and supply a non-default PostgreSQL role
# and strong password through the deployment environment or secret manager.
# The application rejects these sample credentials in production.
APP_ENV=development

# Local development database used inside the Docker network.
POSTGRES_DB=ai_trading
POSTGRES_USER=ai_trading
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql+psycopg://ai_trading:change-me-local-only@postgres:5432/ai_trading

# Used only with: docker compose -f docker-compose.yml -f docker-compose.dev.yml up
# Host access is opt-in and binds to loopback only.
POSTGRES_DEV_PORT=5432

# Backend application.
APP_NAME=AI Trading Platform API
APP_VERSION=0.1.0
APP_LOG_LEVEL=INFO
APP_TIMEZONE=UTC
API_V1_PREFIX=/api/v1
DATABASE_ECHO=false
MARKET_DATA_DEFAULT_LIMIT=500
MARKET_DATA_MAX_LIMIT=1000
MARKET_DATA_REQUEST_TIMEOUT_SECONDS=10
MARKET_DATA_REQUEST_MAX_ATTEMPTS=2
MARKET_DATA_RETRY_BACKOFF_SECONDS=0.25
BINANCE_PUBLIC_BASE_URL=https://api.binance.com
STRATEGY_CONFIG_PATH=/app/config/strategy.yaml
STRATEGY_MARKET_DATA_LIMIT=1000
STRATEGY_MARKET_DATA_MAX_STALENESS_SECONDS=120

# Historical point-in-time cutoff is disabled for public production requests.
# Enable only in an authorized research environment and supply the token via a
# secret manager; never commit a real token.
STRATEGY_RESEARCH_CUTOFF_ENABLED=false
STRATEGY_RESEARCH_CUTOFF_TOKEN=

# OpenAI is an optional secondary validator and remains disabled by default.
OPENAI_VALIDATION_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_VALIDATION_TIMEOUT_SECONDS=10
OPENAI_VALIDATION_MIN_CONFIDENCE=50

# Frontend.
FRONTEND_PORT=3000
BACKEND_API_URL=http://localhost:8000
BACKEND_PROXY_TIMEOUT_MS=10000
