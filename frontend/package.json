    "@testing-library/react": "16.3.2",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "9.39.2",
    "eslint-config-next": "16.3.3",
    "jsdom": "26.1.0",
    "tailwindcss": "4.3.3",
